async function lbLogin() {
  const userEl = document.getElementById("lb-username");
  const passEl = document.getElementById("lb-password");

  if (!userEl || !passEl) {
    console.error("Login inputs not found in DOM");
    alert("Login form is not correctly loaded. Please refresh the page.");
    return;
  }

  const username = userEl.value.trim();
  const password = passEl.value;

  if (!username || !password) {
    alert("Please enter both username and password.");
    return;
  }

  try {
    // 1) Call FastAPI /auth/login exactly like the working curl (form-encoded)
    const body = new URLSearchParams();
    body.append("username", username);
    body.append("password", password);

    const res = await fetch("/auth/login", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: body
    });

    if (res.status === 401) {
      alert("Login failed. Please check your credentials.");
      return;
    }

    if (!res.ok) {
      console.error("Login HTTP error", res.status);
      alert("Login error. Please try again later.");
      return;
    }

    const data = await res.json();
    const token = data.access_token;
    const tokenType = data.token_type || "bearer";
    let role = data.role || "enduser";
    const effectiveUser = data.username || username;

    if (!token) {
      alert("Login failed: no token returned from auth service.");
      return;
    }

    // 2) Store JWT + profile locally for the React / portal UI
    localStorage.setItem("lb_jwt", token);
    localStorage.setItem("lb_jwt_type", tokenType);
    localStorage.setItem("lb_username", effectiveUser);

    // 3) Ask /api/auth/me for final role (uses the same UI-gateway auth proxy)
    try {
      const meRes = await fetch("/api/auth/me", {
        headers: { "Authorization": `${tokenType} ${token}` }
      });

      if (meRes.ok) {
        const me = await meRes.json();
        if (me.role) {
          role = me.role;
        }
      }
    } catch (e) {
      console.warn("Could not fetch /api/auth/me, keeping role from token.", e);
    }

    const profile = { user: effectiveUser, role, ts: new Date().toISOString() };
    localStorage.setItem("lb_portal_profile", JSON.stringify(profile));

    // 4) Redirect based on role – content pages should keep chat visible
    if (role === "hr") {
      window.location.href = "hr-dashboard.html";
    } else if (role === "it" || role === "admin") {
      window.location.href = "it-dashboard.html";
    } else {
      // default end-user awareness view
      window.location.href = "awareness.html";
    }
  } catch (e) {
    console.error("Login exception", e);
    alert("Login error. Please try again later.");
  }
}
