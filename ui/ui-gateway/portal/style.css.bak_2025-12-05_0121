body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  background: radial-gradient(circle at top, #060014, #010008);
  color: #f5f5f7;
}

.lb-bg {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at center, #12002c, #060014);
  padding: 2rem;
}

.lb-card {
  width: 420px;
  background: rgba(20, 0, 50, 0.85);
  border-radius: 28px;
  padding: 2.7rem 2.8rem;
  box-shadow: 0 0 60px rgba(255, 0, 200, 0.25),
              0 0 30px rgba(0, 180, 255, 0.15);
  border: 1px solid rgba(200, 0, 255, 0.25);
}

.lb-header {
  text-align: center;
  margin-bottom: 1.9rem;
}

.lb-logo {
  width: 85px;
  height: 85px;
  object-fit: contain;
  margin-bottom: 1rem;
  filter: drop-shadow(0 0 12px rgba(255, 0, 200, 0.6));
}

.lb-subtitle {
  color: #cfc9e8;
  opacity: 0.85;
  margin-top: 0.2rem;
  font-size: 0.95rem;
}

label {
  display: block;
  margin-bottom: 0.4rem;
  color: #e5e7eb;
}

input {
  width: 100%;
  padding: 0.75rem 1rem;
  margin-bottom: 1.1rem;
  border-radius: 12px;
  border: 1px solid #3a0a5f;
  background: #0b021c;
  color: #fafafa;
}

input:focus {
  border-color: #d946ef;
  box-shadow: 0 0 0 2px rgba(217, 70, 239, 0.4);
  outline: none;
}

#lb-submit {
  width: 100%;
  padding: 0.9rem;
  border-radius: 14px;
  border: none;
  background: linear-gradient(135deg, #06b6d4, #a855f7, #ec4899);
  font-weight: 600;
  color: #05010a;
  cursor: pointer;
}

#lb-submit:hover {
  filter: brightness(1.08);
}

.lb-error {
  display: none;
  margin: 0.3rem 0 1rem 0;
  background: rgba(120, 0, 0, 0.5);
  border-radius: 10px;
  color: #ffbaba;
  padding: 0.55rem 0.8rem;
  text-align: center;
}

.lb-error.visible {
  display: block;
}
