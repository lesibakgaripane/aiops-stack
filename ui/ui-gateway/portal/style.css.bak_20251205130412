/* Global layout */
body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  background: radial-gradient(circle at top, #020617 0%, #020011 40%, #010005 100%);
  color: #f9fafb;
}

/* Main background wrapper */
.lb-bg {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2.5rem;
  padding: 2.5rem 1.5rem;
  background:
    radial-gradient(circle at 0% 0%, rgba(56, 189, 248, 0.18), transparent 60%),
    radial-gradient(circle at 100% 100%, rgba(168, 85, 247, 0.2), transparent 55%);
}

/* Login card */
.lb-card {
  width: 420px;
  max-width: 100%;
  background: radial-gradient(circle at top left, #020617, #020013);
  border-radius: 26px;
  padding: 2.5rem 2.75rem;
  box-shadow:
    0 22px 45px rgba(15, 23, 42, 0.9),
    0 0 40px rgba(56, 189, 248, 0.35);
  border: 1px solid rgba(148, 163, 184, 0.4);
}

/* Header + logo */
.lb-header {
  text-align: center;
  margin-bottom: 2rem;
}

.lb-logo {
  max-width: 180px;
  height: auto;
  margin-bottom: 1rem;
  filter:
    drop-shadow(0 0 12px rgba(15, 23, 42, 0.9))
    drop-shadow(0 0 16px rgba(56, 189, 248, 0.4));
}

.lb-header h1 {
  margin: 0 0 0.5rem 0;
  font-size: 1.6rem;
  letter-spacing: 0.03em;
}

.lb-subtitle {
  margin: 0;
  font-size: 0.9rem;
  color: #9ca3af;
}

/* Form styles */
form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 1rem;
}

label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #6b7280;
  margin-left: 0.1rem;
}

input {
  width: 100%;
  padding: 0.75rem 0.9rem;
  background: rgba(15, 23, 42, 0.9);
  border-radius: 0.75rem;
  border: 1px solid rgba(148, 163, 184, 0.5);
  color: #e5e7eb;
  font-size: 0.95rem;
  box-sizing: border-box;
  outline: none;
  transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

input::placeholder {
  color: #6b7280;
}

input:focus {
  border-color: #38bdf8;
  box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.8);
  background: rgba(15, 23, 42, 1);
}

/* Button */
#lb-submit {
  margin-top: 0.8rem;
  width: 100%;
  padding: 0.9rem;
  border-radius: 0.9rem;
  border: none;
  background-image: linear-gradient(135deg, #38bdf8 0%, #6366f1 40%, #a855f7 100%);
  color: #f9fafb;
  font-weight: 600;
  font-size: 0.98rem;
  cursor: pointer;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  transition: transform 0.1s ease, box-shadow 0.18s ease, filter 0.18s ease;
}

#lb-submit:hover {
  filter: brightness(1.05);
  box-shadow: 0 14px 35px rgba(56, 189, 248, 0.45);
  transform: translateY(-1px);
}

#lb-submit:active {
  transform: translateY(0);
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.8);
}

/* Error + footnote */
.lb-error {
  min-height: 1.2rem;
  margin: 0.2rem 0 0;
  font-size: 0.85rem;
  text-align: center;
  color: #f97373;
}

.lb-footnote {
  margin: 0;
  margin-top: 0.5rem;
  font-size: 0.8rem;
  color: #6b7280;
  text-align: center;
}

/* Hero / promo section under the login card */
.lb-hero {
  max-width: 900px;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
  padding: 0 0.5rem;
}

.lb-hero-slide {
  padding: 1.4rem 1.2rem;
  border-radius: 1.5rem;
  background: linear-gradient(
    145deg,
    rgba(15, 23, 42, 0.95),
    rgba(15, 23, 42, 0.75),
    rgba(30, 64, 175, 0.7)
  );
  border: 1px solid rgba(148, 163, 184, 0.4);
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.9);
  position: relative;
  overflow: hidden;
}

/* Accent lines to echo LesiBytes energy */
.lb-hero-slide::before {
  content: "";
  position: absolute;
  inset: -40%;
  background:
    conic-gradient(
      from 220deg,
      rgba(56, 189, 248, 0.15),
      transparent,
      rgba(168, 85, 247, 0.2),
      transparent
    );
  opacity: 0.7;
  filter: blur(22px);
  z-index: -1;
}

/* Slide-specific colour hints (bluish / teal / magenta) */
.slide-1 h2 { color: #e0f2fe; }
.slide-2 h2 { color: #bfdbfe; }
.slide-3 h2 { color: #e9d5ff; }

.lb-hero-slide h2 {
  margin: 0 0 0.4rem;
  font-size: 1rem;
}

.lb-hero-slide p {
  margin: 0;
  font-size: 0.85rem;
  color: #cbd5f5;
}

/* Simple float animation on hero cards */
@keyframes lbFloat {
  0%   { transform: translateY(0px); }
  50%  { transform: translateY(-4px); }
  100% { transform: translateY(0px); }
}

.lb-hero-slide {
  animation: lbFloat 8s ease-in-out infinite;
}

.slide-2 { animation-delay: 0.6s; }
.slide-3 { animation-delay: 1.2s; }

/* Responsive adjustments */
@media (max-width: 900px) {
  .lb-bg {
    padding: 1.5rem 1.2rem 2rem;
  }

  .lb-card {
    padding: 2.1rem 1.8rem;
    width: 100%;
  }

  .lb-hero {
    grid-template-columns: 1fr;
  }
}
