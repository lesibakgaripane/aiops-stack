<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="style.css">
</head>
<body class="role-admin">
  <header class="portal-header">
    <h1>Admin Dashboard</h1>
    <div class="user-info">
      <span id="userName"></span> • <span id="userGroup"></span>
      <button onclick="logout()">Logout</button>
    </div>
  </header>

  <main class="portal-grid">
    <section class="card">
      <h2>User & Profile Administration</h2>
      <ul>
        <li>View list of users (future API)</li>
        <li>Update user roles (except Super-Admin)</li>
        <li>Reset passwords and unlock accounts</li>
      </ul>
      <p><em>These will hook into the real auth API later; for now this is the UX skeleton.</em></p>
    </section>

    <section class="card">
      <h2>Operational Views</h2>
      <ul>
        <li><a href="http://localhost:8081" target="_blank">Zabbix Overview</a></li>
        <li><a href="http://localhost:8000" target="_blank">LibreNMS Overview</a></li>
        <li><a href="http://localhost:5601" target="_blank">Kibana Dashboards</a></li>
      </ul>
    </section>

    <section class="card">
      <h2>Cybersecurity Awareness Overview</h2>
      <p>Admins can monitor awareness adoption and completion rates (future):</p>
      <ul>
        <li>Training completion per department</li>
        <li>Risk scores per group</li>
        <li>Campaign status</li>
      </ul>
    </section>
  </main>

  <script>
    function populateUser() {
      const u = localStorage.getItem("aiops_username") || "unknown";
      const g = localStorage.getItem("aiops_group") || "Admin";
      document.getElementById("userName").textContent = u;
      document.getElementById("userGroup").textContent = g;
    }
    function logout() {
      localStorage.removeItem("aiops_token");
      localStorage.removeItem("aiops_username");
      localStorage.removeItem("aiops_backend_role");
      localStorage.removeItem("aiops_group");
      window.location.href = "/portal/login.html";
    }
    document.addEventListener("DOMContentLoaded", populateUser);
  </script>
</body>
</html>
